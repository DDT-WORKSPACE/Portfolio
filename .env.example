# Set only after the owner supplies real details.
SITE_URL=
PROJECT_WEBHOOK_URL=
PROJECT_WEBHOOK_TOKEN=
NEWSLETTER_WEBHOOK_URL=
NEWSLETTER_WEBHOOK_TOKEN=
CALENDAR_EMBED_URL=
NEXT_PUBLIC_ANALYTICS_SRC=
NEXT_PUBLIC_ANALYTICS_SITE_ID=

# Email delivery for enquiries and visitor notifications (lib/mail.ts).
# With Gmail: SMTP_USER is the Gmail address, SMTP_PASS is a Gmail App Password
# (Google Account > Security > 2-Step Verification > App passwords). Not your normal password.
SMTP_USER=
SMTP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# Where mail is delivered. Defaults to the site email (devsdevtech@gmail.com).
MAIL_TO=
# Visit notification emails (app/api/visit/route.ts). Set to off to stop them.
VISITOR_EMAILS=on
# Approximate location by IP lookup (ipapi.co) when the host sends no geo headers. off to skip.
VISITOR_GEO=on
